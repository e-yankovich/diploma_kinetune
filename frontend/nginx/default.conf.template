# nginx for the Kinetune SPA. ${BACKEND_URL} is filled in at container start.
# Privacy (NFR7): the access log has no client IP address; the error log is
# kept at "crit" because lower levels include the client address.

log_format kinetune_noip '$time_iso8601 "$request" $status $body_bytes_sent $request_time rid=$kinetune_request_id';

# pass the client's X-Request-ID on, or create one
map $http_x_request_id $kinetune_request_id {
    default $http_x_request_id;
    ""      $request_id;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    access_log /dev/stdout kinetune_noip;
    error_log /dev/stderr crit;

    # API: same origin for the browser, so no CORS is needed
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $kinetune_request_id;
        proxy_read_timeout 15s;
    }

    # hashed build assets can be cached for a long time
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # client-side routes (/exercises/1, /families, ...) all serve index.html
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
