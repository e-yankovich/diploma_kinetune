Project kinetune {
  database_type: 'PostgreSQL'
  // all objects live in PostgreSQL schema "kinetune"
  Note: 'Hybrid recommendation system for adapting group training plans'
}

// ───────────── Enums ─────────────

Enum phase {
  warm_up
  main
  cool_down
}

Enum exercise_mode {
  dynamic         // BR2: only dynamic in warm-up; BR4
  static          // BR4, BR5: static <= 40% of main part
  stato_dynamic   // not in warm-up (BR2), not counted as static (BR5)
}

Enum starting_pose {
  seated
  standing
  balance         // the only pose used by the rules: BR9, BR11, graph attribute
  quadruped
  downward_dog
  supine
  prone
  kneeling
  front_split
}

Enum side {
  left
  right
  both
}

Enum relation_type {
  variation    // same level, different execution (undirected)
  progression  // from -> to is harder by >= 1 attribute, easier by none (reverse = regression)
}

Enum session_status {
  open      // check-in link active
  closed    // coach closed check-in (US3.2), recommendations generated
  reviewed  // every recommendation decided, concrete plan re-checked (BR1–BR8)
  done      // class held, attendance entered
}

Enum plan_status {
  draft      // being built; any change returns here
  completed  // built; target_duration_min required
  reviewed   // BR1–BR8 check run and reviewed; sessions only from here
}

Enum load_level {
  low
  medium
  high       // BR9/BR10: high load on a joint of a reported body part triggers
}

Enum energy_level {
  low        // BR9/BR10 factor "low energy"
  normal
  high
}

Enum recommendation_form {
  alternative  // BR9: shown next to the original
  replacement  // BR10: replaces the original
}

Enum explanation_source {
  template
  llm
}

Enum decision_type {
  accepted
  declined
}

// ───────────── Reference data ─────────────

Table body_area {
  id smallint [pk, increment]
  code varchar(32) [unique, not null, note: "e.g. lower_back; CHECK code ~ '^[a-z_]+$'"]
  name_en varchar(64) [not null]
  name_ru varchar(64) [not null, note: 'participant forms EN+RU']
  is_in_checkin boolean [not null, default: false, note: 'shown in the check-in; only these trigger BR9/BR10']
  Note: 'Body part; consists of muscles and joints'
}

Table muscle {
  id smallint [pk, increment]
  name varchar(64) [unique, not null]
  body_area_id smallint [not null]
}

Table joint {
  id smallint [pk, increment]
  name varchar(64) [unique, not null]
  body_area_id smallint [not null]
}

Table rule {
  id smallint [pk, note: 'seeded 1–11 = BR1–BR11; CHECK BETWEEN 1 AND 11']
  description text [not null, note: 'rule logic, for the coach / docs']
  explanation text [not null, note: 'template text shown with a recommendation']
}

// ───────────── Exercise library ─────────────

Table exercise {
  id integer [pk, increment]
  name varchar(120) [unique, not null]
  description text
  mode exercise_mode [not null]
  starting_pose starting_pose [not null]
  is_symmetric boolean [not null, default: true, note: 'false = asymmetric, done per side (BR7); true also for Alternating / Side-to-Side']
  difficulty smallint [not null, note: 'CHECK 1..3']
  rep_duration_sec smallint [not null, note: 'whole seconds for ONE repetition (static: one hold); CHECK > 0']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table exercise_muscle {
  exercise_id integer [not null]
  muscle_id smallint [not null]
  is_primary boolean [not null, default: false, note: 'true = the stretched (target) muscle']
  indexes {
    (exercise_id, muscle_id) [pk]
  }
}

Table exercise_joint {
  exercise_id integer [not null]
  joint_id smallint [not null]
  is_primary boolean [not null, default: false, note: 'main joint of the exercise; library sorting/filtering/display']
  load_level load_level [not null, note: 'main and secondary joints: BR9/BR10 (high triggers), BR11 cascade, graph derivation']
  indexes {
    (exercise_id, joint_id) [pk]
  }
  Note: 'is_primary and load_level are independent: a lunge is about the hip (primary) but loads the knee highly (not primary, load high)'
}

Table exercise_family {
  id smallint [pk, increment]
  name varchar(64) [unique, not null, note: "CHECK btrim(name) <> ''"]
  Note: 'Movement family: exercises that can stand in for each other (>= 2 members expected)'
}

Table exercise_family_member {
  exercise_id integer [not null]
  family_id smallint [not null]
  indexes {
    (exercise_id, family_id) [pk]
    family_id
  }
  Note: 'M:N; up to three families per exercise in the library sheet'
}

Table exercise_compensation {
  exercise_id integer [not null]
  compensation_exercise_id integer [not null]
  indexes {
    (exercise_id, compensation_exercise_id) [pk]
    compensation_exercise_id
  }
  Note: 'BR6: acceptable compensating exercises; any one that follows satisfies the rule. CHECK exercise_id <> compensation_exercise_id'
}

Table exercise_relation {
  id integer [pk, increment]
  from_exercise_id integer [not null]
  to_exercise_id integer [not null]
  type relation_type [not null]
  is_directed boolean [not null, default: true]
  is_manual boolean [not null, default: false, note: 'false = derived on import (families + attributes); true = manual progression']
  indexes {
    (`LEAST(from_exercise_id, to_exercise_id)`, `GREATEST(from_exercise_id, to_exercise_id)`) [unique, name: 'uq_exercise_relation_pair', note: 'one edge per pair (DQ36)']
    (from_exercise_id, type) [note: 'recursive candidate search']
    (to_exercise_id) [note: 'undirected edges are also traversed backwards']
  }
  Note: '''Graph edges, traversed with WITH RECURSIVE (depth <= 2).
CHECK from_exercise_id <> to_exercise_id.
Undirected edges stored once: CHECK (is_directed OR from_exercise_id < to_exercise_id).'''
}

// ───────────── Access control (application roles) ─────────────

Table app_user {
  id integer [pk, increment]
  email varchar(254) [unique, not null, note: 'stored lower-case: CHECK email = lower(email)']
  password_hash text [not null, note: 'argon2id']
  display_name varchar(80) [not null, note: "CHECK btrim <> ''"]
  is_active boolean [not null, default: true, note: 'false = cannot log in; rows kept for history']
  created_at timestamptz [not null, default: `now()`]
  last_login_at timestamptz
  Note: 'Any account that logs in (coach, admin; client later). Personal data.'
}

Table role {
  id smallint [pk, increment]
  code varchar(32) [unique, not null, note: "coach, admin (client later); CHECK code ~ '^[a-z_]+$'"]
  name varchar(64) [not null]
  description text
}

Table permission {
  id smallint [pk, increment]
  code varchar(64) [unique, not null, note: "<resource>.<action>, e.g. plan.write; CHECK code ~ '^[a-z_]+\\.[a-z_]+$'"]
  description text [not null]
}

Table role_permission {
  role_id smallint [not null]
  permission_id smallint [not null]
  indexes {
    (role_id, permission_id) [pk]
  }
}

Table user_role {
  user_id integer [not null]
  role_id smallint [not null]
  granted_at timestamptz [not null, default: `now()`]
  granted_by integer [note: 'admin who granted it; NULL for seed / bootstrap']
  indexes {
    (user_id, role_id) [pk]
  }
  indexes {
    role_id [note: 'who holds role X (last-admin, coach-role checks)']
  }
  Note: 'M:N — one person can be both coach and admin'
}

// ───────────── Planning ─────────────

Table plan {
  id integer [pk, increment]
  coach_id integer [not null, note: 'app_user with role coach']
  title varchar(120) [not null]
  notes text
  target_duration_min smallint [note: "class length for BR8; CHECK > 0; NOT NULL unless status = 'draft'"]
  status plan_status [not null, default: 'draft', note: 'trigger: draft -> completed -> reviewed; any change of the plan or its items -> draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: '''Blueprint of a class. Locked (items and all fields) as soon as any session uses it;
change a locked plan through duplicate_plan(plan_id).'''
}

Table plan_item {
  id integer [pk, increment]
  plan_id integer [not null]
  exercise_id integer [not null]
  phase phase [not null]
  position smallint [not null, note: 'CHECK >= 1; continuous 1..n per phase']
  side side [not null, default: 'both', note: "symmetric exercise -> 'both'"]
  reps_count smallint [not null, note: 'per side for asymmetric, total for symmetric; holds for static; CHECK > 0']
  indexes {
    (plan_id, phase, position) [unique, note: 'DEFERRABLE INITIALLY DEFERRED (reordering)']
  }
  Note: '''Duration is calculated, not stored: item_duration_sec() =
reps_count x exercise.rep_duration_sec, x2 if asymmetric and side = both.
Read through view v_plan_item (blueprint) or v_session_plan (concrete plan of a session).'''
}

// ───────────── Sessions & participant input ─────────────

Table session {
  id integer [pk, increment]
  coach_id integer [not null, note: 'app_user with role coach; = plan owner']
  plan_id integer [not null, note: 'trigger: plan must be reviewed; the plan is locked from then on']
  group_name varchar(80) [not null, note: "CHECK btrim <> ''"]
  starts_at timestamptz [not null]
  status session_status [not null, default: 'open', note: 'trigger: new session starts open; open -> closed -> reviewed (all recommendations decided) -> done']
  checkin_token varchar(43) [unique, not null, note: "random 32 bytes base64url; CHECK ~ '^[A-Za-z0-9_-]{43}$'"]
  checkin_closed_at timestamptz [note: "CHECK (status = 'open') = (checkin_closed_at IS NULL)"]
  participants_present smallint [note: "entered when the check-in is closed; base for BR9/BR10, K2, K4; CHECK >= 0; NOT NULL unless status = 'open'"]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    starts_at
    plan_id [note: 'plan lock check']
  }
  Note: 'Concrete plan of one class = plan + decisions on its recommendations; calculated by view v_session_plan (no copy)'
}

Table checkin {
  id integer [pk, increment]
  session_id integer [not null]
  energy energy_level [not null, note: 'low / normal / high']
  poor_sleep boolean [not null]
  language char(2) [not null, note: "CHECK IN ('en', 'ru')"]
  submitted_at timestamptz [not null, default: `now()`]
  indexes {
    session_id
  }
  Note: 'Anonymous. Trigger: reject insert when session.status <> open'
}

Table checkin_discomfort {
  checkin_id integer [not null]
  body_area_id smallint [not null]
  indexes {
    (checkin_id, body_area_id) [pk]
  }
}

Table feedback {
  id integer [pk, increment]
  session_id integer [not null]
  rating smallint [not null, note: 'CHECK 1..5']
  comment text [note: 'CHECK char_length <= 1000']
  submitted_at timestamptz [not null, default: `now()`]
  indexes {
    session_id
  }
  Note: 'Anonymous, voluntary, after class (E6, Should); base for K4. Trigger: accept only when session.status <> open'
}

// ───────────── Recommendations ─────────────

Table recommendation {
  id integer [pk, increment]
  session_id integer [not null]
  plan_item_id integer [not null]
  rule_id smallint [not null]
  form recommendation_form [not null, note: 'what the rule called for']
  is_warning boolean [not null, default: false, note: 'no suitable substitute found -> general advice']
  candidate_exercise_id integer [note: 'NULL when is_warning']
  affected_count smallint [not null, note: 'check-ins reporting the issue; CHECK >= 0']
  explanation text [not null, note: "CHECK btrim <> ''"]
  explanation_source explanation_source [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    session_id
  }
  Note: 'CHECK is_warning = (candidate_exercise_id IS NULL)'
}

Table recommendation_decision {
  recommendation_id integer [pk]
  decision decision_type [not null]
  decided_at timestamptz [not null, default: `now()`]
  Note: '''Warnings are decided too. K3 = accepted / decided.
Trigger: at most one accepted replacement per plan item and session.'''
}

// ───────────── Views and functions (calculated, not stored) ─────────────
// item_duration_sec(reps_count, rep_duration_sec, is_symmetric, side) -> integer
// plan_is_locked(plan_id) -> boolean            (any session uses the plan)
// duplicate_plan(plan_id, title = NULL) -> new draft plan id
// v_plan_item:    plan_id, plan_item_id, seq, phase, position, exercise_id, side, reps_count, duration_sec
// v_session_plan: session_id, plan_id, plan_item_id, seq, phase, position,
//                 exercise_id (effective, after accepted replacement), original_exercise_id, is_replaced,
//                 replacement_recommendation_id, alternative_exercise_ids (accepted alternatives),
//                 side, reps_count, duration_sec


// ───────────── Relationships (ON DELETE behaviour) ─────────────

Ref: role_permission.role_id > role.id [delete: cascade]
Ref: role_permission.permission_id > permission.id [delete: cascade]
Ref: user_role.user_id > app_user.id [delete: cascade]
Ref: user_role.role_id > role.id [delete: restrict]
Ref: user_role.granted_by > app_user.id [delete: set null]
Ref: muscle.body_area_id > body_area.id [delete: restrict]
Ref: joint.body_area_id > body_area.id [delete: restrict]
Ref: exercise_family_member.exercise_id > exercise.id [delete: cascade]
Ref: exercise_family_member.family_id > exercise_family.id [delete: restrict]
Ref: exercise_compensation.exercise_id > exercise.id [delete: cascade]
Ref: exercise_compensation.compensation_exercise_id > exercise.id [delete: restrict]
Ref: exercise_muscle.exercise_id > exercise.id [delete: cascade]
Ref: exercise_muscle.muscle_id > muscle.id [delete: restrict]
Ref: exercise_joint.exercise_id > exercise.id [delete: cascade]
Ref: exercise_joint.joint_id > joint.id [delete: restrict]
Ref: exercise_relation.from_exercise_id > exercise.id [delete: cascade]
Ref: exercise_relation.to_exercise_id > exercise.id [delete: cascade]
Ref: plan.coach_id > app_user.id [delete: restrict]
Ref: plan_item.plan_id > plan.id [delete: cascade]
Ref: plan_item.exercise_id > exercise.id [delete: restrict]
Ref: session.coach_id > app_user.id [delete: restrict]
Ref: session.plan_id > plan.id [delete: restrict]
Ref: checkin.session_id > session.id [delete: cascade]
Ref: checkin_discomfort.checkin_id > checkin.id [delete: cascade]
Ref: checkin_discomfort.body_area_id > body_area.id [delete: restrict]
Ref: feedback.session_id > session.id [delete: cascade]
Ref: recommendation.session_id > session.id [delete: cascade]
Ref: recommendation.plan_item_id > plan_item.id [delete: restrict]
Ref: recommendation.rule_id > rule.id [delete: restrict]
Ref: recommendation.candidate_exercise_id > exercise.id [delete: restrict]
Ref: recommendation_decision.recommendation_id - recommendation.id [delete: cascade]
