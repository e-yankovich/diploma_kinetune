# Kinetune — environment template
# Copy to .env and set real passwords:  cp .env.example .env
# .env is git-ignored and must never be committed.

# Database name
POSTGRES_DB=kinetune

# Cluster superuser (created by the postgres image). Used only to bootstrap
# the login roles and for maintenance — never by the app or by migrations.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_superuser

# Login roles created on first start by db/init/10_login_roles.sh:
#   kinetune_migrator — owns all objects, runs migrations (not a superuser)
#   kinetune_api      — the FastAPI backend          (group role app_write)
#   kinetune_reader   — read-only reports            (group role app_read)
#   kinetune_admin    — library import, reference data (group role app_admin)
MIGRATOR_PASSWORD=change_me_migrator
API_PASSWORD=change_me_api
READER_PASSWORD=change_me_reader
ADMIN_PASSWORD=change_me_admin

# Host port for PostgreSQL (bound to 127.0.0.1 only). Default 5432.
DB_PORT=5432
